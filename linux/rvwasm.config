# Kernel config fragment for rvwasm, applied on top of `tinyconfig`.
# Target: RV64GC (RV64IMAFDC + Zicsr/Zifencei), Sv39, one hart, SBI provided by the emulator.
CONFIG_64BIT=y
CONFIG_MMU=y
CONFIG_NONPORTABLE=y
CONFIG_RISCV_ISA_C=y
CONFIG_FPU=y
CONFIG_RISCV_ISA_V=n
CONFIG_RISCV_ISA_ZICBOM=n
CONFIG_RISCV_ISA_ZICBOZ=n
CONFIG_RISCV_ISA_ZBB=n
CONFIG_RISCV_ISA_ZBA=n
CONFIG_RISCV_ISA_ZBC=n
CONFIG_RISCV_ISA_ZAWRS=n
CONFIG_RISCV_ISA_SVPBMT=n
CONFIG_RISCV_ISA_SVNAPOT=n
CONFIG_SMP=n
CONFIG_EFI=n
CONFIG_RELOCATABLE=n
CONFIG_RANDOMIZE_BASE=n
CONFIG_CMDLINE=""

# Console and early output
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_EARLY_PRINTK=y
CONFIG_TTY=y
CONFIG_UNIX98_PTYS=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_OF_PLATFORM=y
CONFIG_SERIAL_8250_NR_UARTS=1
CONFIG_SERIAL_8250_RUNTIME_UARTS=1
CONFIG_SERIAL_EARLYCON_RISCV_SBI=y
CONFIG_HVC_RISCV_SBI=y

# Interrupts and timer
CONFIG_SIFIVE_PLIC=y
CONFIG_RISCV_TIMER=y

# Userspace essentials for BusyBox
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_MULTIUSER=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_SHMEM=y
CONFIG_POSIX_TIMERS=y
CONFIG_FILE_LOCKING=y
CONFIG_AIO=y
CONFIG_ADVISE_SYSCALLS=y

# virtio block device (optional disk)
CONFIG_BLOCK=y
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_BLK=y
CONFIG_EXT2_FS=y
